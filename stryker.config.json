{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "deploy/load-check.ts",
    "public/call-core.js",
    "!src/**/*.test.ts",
    "!src/server/main.ts",
    "!src/types/**",
    "!src/script/fixture.ts"
  ],
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 70
  },
  "ignorePatterns": [".skein", "docs", ".data", "reports"],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tsconfigFile": "stryker-skip-tsconfig-preprocessor.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "tempDirName": ".stryker-tmp"
}
