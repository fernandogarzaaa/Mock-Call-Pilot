# Copy to .env for local runs. Never commit .env.
MODE=demo
STORAGE=fs
STORAGE_DIR=./.data
BUCKET=
# STORAGE=r2 (Render): see README "Render environment variables"
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STT=fake
PICKER=fake
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
SCRIBE_MODEL=scribe_v1
# STT=groq uses Whisper on Groq's free tier instead of ElevenLabs.
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# TTS=groq uses Orpheus on Groq's free tier to read the prospect's lines aloud.
# TTS=fake is the default: the voice route answers silence, so the page stays text only.
TTS=fake
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=austin
GROQ_TTS_VOICE_FEMALE=autumn
PICKER_MODEL=claude-opus-5-5
PICKER_EFFORT=low
# PROSPECT=generative makes John answer in his own words (Claude, same key and model as
# the picker) instead of picking a script line. Default is scripted. Needs ANTHROPIC_API_KEY.
PROSPECT=scripted
ACCESS_CODE=
URL_SIGNING_SECRET=change-me-for-local-dev
PORT=3000
