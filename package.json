{
  "name": "mock-call-pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "MODE=demo STORAGE=fs STT=fake PICKER=fake node --env-file-if-exists=.env --watch src/server/main.ts",
    "dev:real": "MODE=demo STORAGE=fs STT=scribe PICKER=claude node --env-file-if-exists=.env src/server/main.ts",
    "start": "node src/server/main.ts",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@google-cloud/storage": "^9.0.0",
    "@hono/node-server": "^2.1.9",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
